# ==============================================================================
# Work Log & Timesheet System - Server Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# For Render deployment, add these exact key-value pairs in Render > Environment.

# ── 1. Application & Server Configuration ─────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── 2. Database Connection (PostgreSQL / Supabase) ───────────────────────────
# Transaction Mode Pooler (Port 6543) for runtime queries:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=20"
# Direct connection (Port 5432) for Prisma migrations / db push:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── 3. Frontend & CORS Policy ─────────────────────────────────────────────────
# The full URL of your deployed frontend (no trailing slash, e.g. https://my-timesheet-app.onrender.com)
FRONTEND_URL="https://your-frontend-app.onrender.com"
# CORS origin allowed to make API requests (must match FRONTEND_URL in production)
CORS_ORIGIN="https://your-frontend-app.onrender.com"

# ── 4. JWT Authentication & Security ──────────────────────────────────────────
# Generate a strong 64-char hex string: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-64-character-secret"
JWT_EXPIRES_IN="24h"

# ── 5. User Registration & Domain Access Controls ─────────────────────────────
# ALLOW_PUBLIC_REGISTRATION:
#   - 'true'  -> Anyone can self-register via /register
#   - 'false' -> Public registration disabled; accounts can only be created via admin/manager invites
ALLOW_PUBLIC_REGISTRATION="true"

# REGISTRATION_ALLOWED_DOMAINS: Comma-separated list of allowed email domains (e.g. "mycompany.com,partner.org")
# Leave empty ("") to allow registrations from any email domain (gmail, outlook, etc.)
REGISTRATION_ALLOWED_DOMAINS=""

# ── 6. Distributed Rate Limiting & Redis (Optional) ───────────────────────────
# Set to 'true' if running multiple server instances behind a load balancer with Redis
DISTRIBUTED_RATE_LIMIT="false"
# Redis connection string (required only if DISTRIBUTED_RATE_LIMIT is 'true')
REDIS_URL="redis://default:[PASSWORD]@[REDIS-HOST]:6379"

# ── 7. Supabase & Edge Function Email Delivery ────────────────────────────────
# Recommended on Render Free Tier to bypass outbound SMTP port blocking (ports 25, 465, 587)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Public Anon Key from Supabase Dashboard > Settings > API
SUPABASE_ANON_KEY="eyJhbGciOi..."
# Optional alternative to anon key
SUPABASE_SERVICE_ROLE_KEY=""
# Edge function endpoint for email sender
SUPABASE_FUNCTION_URL="https://[PROJECT-REF].supabase.co/functions/v1/send-email"
# Set to 'true' to force edge function email delivery (automatically active in production if SUPABASE_FUNCTION_URL is set)
USE_SUPABASE_EMAIL="true"

# ── 8. SMTP Direct Mailer (Gmail / Custom SMTP) ───────────────────────────────
# Used when sending directly via Nodemailer (if outbound SMTP ports are accessible)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
APP_PASSWORD="your-16-char-gmail-app-password"
EMAIL_FROM="Work Log & Timesheet System <your-email@gmail.com>"
