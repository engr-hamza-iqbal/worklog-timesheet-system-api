# Database connection (PostgreSQL / Supabase)
# For Supabase PgBouncer, use a shared pool with a higher connection_limit than 1.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=20"

# Application configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# CORS & Frontend Origins (comma-separated or * to allow all)
CORS_ORIGIN="*"
FRONTEND_URL="http://localhost:5173"

# Resend HTTP email provider. Keep the API key only in local/production secrets.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Work Log <onboarding@resend.dev>"
